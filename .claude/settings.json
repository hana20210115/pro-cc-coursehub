{
  "permissions": {
    "allow": [
      "Bash(./vendor/bin/sail artisan *)",
      "Bash(./vendor/bin/sail composer *)",
      "Bash(./vendor/bin/sail npm *)",
      "Bash(./vendor/bin/sail pint *)",
      "Bash(./vendor/bin/sail up *)",
      "Bash(./vendor/bin/sail ps *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git fetch *)"
    ],
    "deny": [
      "Bash(./vendor/bin/sail artisan migrate:fresh *)",
      "Bash(./vendor/bin/sail artisan migrate:reset *)",
      "Bash(./vendor/bin/sail artisan db:wipe *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/*.php) ;; *) exit 0 ;; esac; cd \"$CLAUDE_PROJECT_DIR\" && ./vendor/bin/sail exec laravel.test ./vendor/bin/pint \"${f#\"$CLAUDE_PROJECT_DIR\"/}\" >/dev/null 2>&1 || true",
            "timeout": 60,
            "statusMessage": "Running Pint..."
          }
        ]
      }
    ]
  }
}
